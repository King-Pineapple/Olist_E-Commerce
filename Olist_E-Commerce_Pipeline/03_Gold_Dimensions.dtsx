    <DTS:Executable
      DTS:refId="Package\21_Load_Dim_Customer_SCD2"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:DelayValidation="True"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0E89239E-B345-4CAF-AF81-E642B41CFCFB}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="21_Load_Dim_Customer_SCD2"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24679D02-DD4B-4FEB-9234-EC8DD7E92CEE}"
          SQLTask:SqlStatementSource="&#xA;SET NOCOUNT ON;&#xA;SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRY&#xA;    BEGIN TRANSACTION;&#xA;&#xA;    /* =====================================================&#xA;       STEP 1: Remove previous temporary staging table&#xA;       ===================================================== */&#xA;&#xA;    IF OBJECT_ID('tempdb..#CustomerVersions') IS NOT NULL&#xA;        DROP TABLE #CustomerVersions;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       STEP 2: Retrieve customer purchase history&#xA;       ===================================================== */&#xA;&#xA;    ;WITH CustomerHistory AS&#xA;    (&#xA;        SELECT&#xA;            c.customer_unique_id,&#xA;            c.customer_zip_code_prefix,&#xA;            c.customer_city,&#xA;            c.customer_state,&#xA;            o.order_purchase_timestamp AS purchase_ts,&#xA;            o.order_id,&#xA;&#xA;            ROW_NUMBER() OVER&#xA;            (&#xA;                PARTITION BY&#xA;                    c.customer_unique_id,&#xA;                    o.order_purchase_timestamp&#xA;                ORDER BY o.order_id, c.customer_id&#xA;            ) AS timestamp_rank&#xA;&#xA;        FROM silver.customers AS c&#xA;&#xA;        INNER JOIN silver.orders AS o&#xA;            ON c.customer_id = o.customer_id&#xA;&#xA;        WHERE c.customer_unique_id IS NOT NULL&#xA;          AND LTRIM(RTRIM(c.customer_unique_id)) &lt;&gt; ''&#xA;          AND o.order_purchase_timestamp IS NOT NULL&#xA;    ),&#xA;&#xA;    /* =====================================================&#xA;       STEP 3: Compare customer locations over time&#xA;       ===================================================== */&#xA;&#xA;    OrderedHistory AS&#xA;    (&#xA;        SELECT&#xA;            *,&#xA;&#xA;            LAG(customer_city) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY purchase_ts, order_id&#xA;            ) AS previous_city,&#xA;&#xA;            LAG(customer_state) OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY purchase_ts, order_id&#xA;            ) AS previous_state,&#xA;&#xA;            ROW_NUMBER() OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY purchase_ts, order_id&#xA;            ) AS purchase_sequence&#xA;&#xA;        FROM CustomerHistory&#xA;        WHERE timestamp_rank = 1&#xA;    ),&#xA;&#xA;    /* =====================================================&#xA;       STEP 4: Identify city/state changes&#xA;       ===================================================== */&#xA;&#xA;    LocationChanges AS&#xA;    (&#xA;        SELECT&#xA;            customer_unique_id,&#xA;            customer_zip_code_prefix,&#xA;            customer_city,&#xA;            customer_state,&#xA;            purchase_ts AS valid_from&#xA;&#xA;        FROM OrderedHistory&#xA;&#xA;        WHERE purchase_sequence = 1&#xA;           OR ISNULL(customer_city, '') &lt;&gt;&#xA;              ISNULL(previous_city, '')&#xA;           OR ISNULL(customer_state, '') &lt;&gt;&#xA;              ISNULL(previous_state, '')&#xA;    ),&#xA;&#xA;    /* =====================================================&#xA;       STEP 5: Identify the current customer version&#xA;       ===================================================== */&#xA;&#xA;    CustomerVersionFlags AS&#xA;    (&#xA;        SELECT&#xA;            customer_unique_id,&#xA;            customer_zip_code_prefix,&#xA;            customer_city,&#xA;            customer_state,&#xA;            valid_from,&#xA;&#xA;            ROW_NUMBER() OVER&#xA;            (&#xA;                PARTITION BY customer_unique_id&#xA;                ORDER BY valid_from DESC&#xA;            ) AS version_rank&#xA;&#xA;        FROM LocationChanges&#xA;    )&#xA;&#xA;    /* =====================================================&#xA;       STEP 6: Resolve Geography surrogate keys&#xA;       ===================================================== */&#xA;&#xA;    SELECT&#xA;        v.customer_unique_id,&#xA;        v.customer_zip_code_prefix,&#xA;        v.customer_city,&#xA;        v.customer_state,&#xA;&#xA;        ISNULL(g.geography_key, -1) AS geography_key,&#xA;&#xA;        v.valid_from,&#xA;&#xA;        CAST(&#xA;            CASE&#xA;                WHEN v.version_rank = 1 THEN 1&#xA;                ELSE 0&#xA;            END AS BIT&#xA;        ) AS is_current&#xA;&#xA;    INTO #CustomerVersions&#xA;&#xA;    FROM CustomerVersionFlags AS v&#xA;&#xA;    OUTER APPLY&#xA;    (&#xA;        SELECT TOP (1)&#xA;            geography_key&#xA;        FROM gold.dim_geography&#xA;        WHERE zip_code_prefix = v.customer_zip_code_prefix&#xA;          AND geography_key &lt;&gt; -1&#xA;        ORDER BY geography_key&#xA;    ) AS g;&#xA;&#xA;&#xA;    /* =====================================================&#xA;       STEP 7: Merge historical customer versions into Gold&#xA;       ===================================================== */&#xA;&#xA;    ;MERGE INTO gold.dim_customers WITH (HOLDLOCK) AS target&#xA;&#xA;    USING #CustomerVersions AS source&#xA;&#xA;    ON target.customer_unique_id = source.customer_unique_id&#xA;       AND target.valid_from = source.valid_from&#xA;&#xA;    WHEN MATCHED THEN&#xA;        UPDATE SET&#xA;            target.customer_zip_code_prefix =&#xA;                source.customer_zip_code_prefix,&#xA;&#xA;            target.customer_city =&#xA;                source.customer_city,&#xA;&#xA;            target.customer_state =&#xA;                source.customer_state,&#xA;&#xA;            target.geography_key =&#xA;                source.geography_key,&#xA;&#xA;            target.is_current =&#xA;                source.is_current&#xA;&#xA;    WHEN NOT MATCHED BY TARGET THEN&#xA;        INSERT&#xA;        (&#xA;            customer_unique_id,&#xA;            customer_zip_code_prefix,&#xA;            customer_city,&#xA;            customer_state,&#xA;            geography_key,&#xA;            valid_from,&#xA;            is_current&#xA;        )&#xA;        VALUES&#xA;        (&#xA;            source.customer_unique_id,&#xA;            source.customer_zip_code_prefix,&#xA;            source.customer_city,&#xA;            source.customer_state,&#xA;            source.geography_key,&#xA;            source.valid_from,&#xA;            source.is_current&#xA;        );&#xA;&#xA;&#xA;    /* =====================================================&#xA;       STEP 8: Remove temporary table and commit&#xA;       ===================================================== */&#xA;&#xA;    DROP TABLE #CustomerVersions;&#xA;&#xA;    COMMIT TRANSACTION;&#xA;&#xA;END TRY&#xA;&#xA;BEGIN CATCH&#xA;&#xA;    IF @@TRANCOUNT &gt; 0&#xA;        ROLLBACK TRANSACTION;&#xA;&#xA;    THROW;&#xA;&#xA;END CATCH;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
