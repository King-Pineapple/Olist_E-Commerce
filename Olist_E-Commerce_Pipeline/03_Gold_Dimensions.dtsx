          SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM [Olist_DWH].sys.tables&#xA;    WHERE name = 'Dim_Date'&#xA;)&#xA;BEGIN&#xA;    &#xA;CREATE TABLE [Olist_DWH].[Gold].[Dim_Date] (&#xA;       &#xA;date_key INT NOT NULL PRIMARY KEY,&#xA;&#xA;full_date DATE NULL,&#xA;&#xA;day_number TINYINT NULL,&#xA;&#xA;day_name VARCHAR(20) NULL,&#xA;&#xA;day_of_week_number TINYINT NULL,&#xA;&#xA;week_number TINYINT NULL,&#xA;&#xA;month_number TINYINT NULL,&#xA;&#xA;month_name VARCHAR(20) NULL,&#xA;&#xA;quarter_number TINYINT NULL,&#xA;&#xA;year_number SMALLINT NULL,&#xA;&#xA;is_weekend BIT NULL &#xA;);&#xA;&#xA;END;&#xA;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
