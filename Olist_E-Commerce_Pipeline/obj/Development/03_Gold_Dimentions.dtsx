        <SQLTask:SqlTaskData
          SQLTask:Connection="{24679D02-DD4B-4FEB-9234-EC8DD7E92CEE}"
          SQLTask:SqlStatementSource=";WITH DateSeries AS&#xA;(&#xA;&#xA;    SELECT CAST('2016-01-01' AS DATE) AS full_date&#xA;&#xA;    UNION ALL&#xA;&#xA;&#xA;    SELECT DATEADD(DAY, 1, full_date)&#xA;&#xA;    FROM DateSeries&#xA;&#xA;    WHERE full_date &lt; '2019-12-31'&#xA;)&#xA;&#xA;INSERT INTO gold.dim_date&#xA;(&#xA;&#xA;    date_key,&#xA;&#xA;    full_date,&#xA;&#xA;    day_number,&#xA;&#xA;    day_name,&#xA;&#xA;    day_of_week_number,&#xA;&#xA;    week_number,&#xA;&#xA;    month_number,&#xA;&#xA;    month_name,&#xA;&#xA;    quarter_number,&#xA;&#xA;    year_number,&#xA;&#xA;    is_weekend&#xA;)&#xA;&#xA;SELECT&#xA;&#xA;    YEAR(d.full_date) * 10000&#xA;&#xA;        + MONTH(d.full_date) * 100&#xA;&#xA;        + DAY(d.full_date),&#xA;&#xA;&#xA;    d.full_date,&#xA;&#xA;    DAY(d.full_date),&#xA;&#xA;    DATENAME(WEEKDAY, d.full_date),&#xA;&#xA;&#xA;    CAST(&#xA;&#xA;        DATEDIFF(DAY, '19000101', d.full_date) % 7 + 1&#xA;        AS TINYINT&#xA;&#xA;    ),&#xA;&#xA;&#xA;    DATEPART(ISO_WEEK, d.full_date),&#xA;&#xA;    MONTH(d.full_date),&#xA;&#xA;    DATENAME(MONTH, d.full_date),&#xA;&#xA;    DATEPART(QUARTER, d.full_date),&#xA;&#xA;    YEAR(d.full_date),&#xA;&#xA;&#xA;    CASE&#xA;&#xA;        WHEN DATEDIFF(DAY, '19000101', d.full_date) % 7&#xA;             IN (5, 6)&#xA;&#xA;        THEN 1&#xA;&#xA;        ELSE 0&#xA;&#xA;    END&#xA;&#xA;FROM DateSeries d&#xA;WHERE NOT EXISTS&#xA;(&#xA;&#xA;    SELECT 1&#xA;&#xA;    FROM gold.dim_date existing&#xA;&#xA;    WHERE existing.date_key =&#xA;&#xA;        YEAR(d.full_date) * 10000&#xA;&#xA;        + MONTH(d.full_date) * 100&#xA;&#xA;        + DAY(d.full_date)&#xA;)&#xA;&#xA;OPTION (MAXRECURSION 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
