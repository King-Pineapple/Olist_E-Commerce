              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[bronze].[Olist_Products_Dataset]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    product_id,
    product_category_name,

    product_name_lenght,
    product_description_lenght,
    product_photos_qty,
    product_weight_g,
    product_length_cm,
    product_height_cm,
    product_width_cm,

    TRY_CONVERT(
        INT, NULLIF(LTRIM(RTRIM(product_name_lenght)), '')
    ) AS Product_Name_Length,

    TRY_CONVERT(
        INT, NULLIF(LTRIM(RTRIM(product_description_lenght)), '')
    ) AS Product_Description_Length,

    TRY_CONVERT(
        INT, NULLIF(LTRIM(RTRIM(product_photos_qty)), '')
    ) AS Product_Photos_Qty_Int,

    TRY_CONVERT(
        DECIMAL(10,2), NULLIF(LTRIM(RTRIM(product_weight_g)), '')
    ) AS Product_Weight_Decimal,

    TRY_CONVERT(
        DECIMAL(10,2), NULLIF(LTRIM(RTRIM(product_length_cm)), '')
    ) AS Product_Length_Decimal,

    TRY_CONVERT(
        DECIMAL(10,2), NULLIF(LTRIM(RTRIM(product_height_cm)), '')
    ) AS Product_Height_Decimal,

    TRY_CONVERT(
        DECIMAL(10,2), NULLIF(LTRIM(RTRIM(product_width_cm)), '')
    ) AS Product_Width_Decimal

FROM Olist_DWH.bronze.Olist_Products_Dataset;</property>
