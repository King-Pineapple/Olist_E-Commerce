              refId="Package\16_Silver_Orders_Cleaning\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset">[bronze].[Olist_Order_Dataset]</property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">WITH CleanDates AS (
    SELECT
        order_id,
        customer_id,
        order_status,

        order_purchase_timestamp AS Raw_Purchase_Date,
        order_approved_at AS Raw_Approved_Date,
        order_delivered_carrier_date AS Raw_Carrier_Date,
        order_delivered_customer_date AS Raw_Customer_Date,
        order_estimated_delivery_date AS Raw_Estimated_Date,

        TRY_CONVERT(DATETIME2(7),
            NULLIF(LTRIM(RTRIM(order_purchase_timestamp)), '')
        ) AS Purchase_Date,

        TRY_CONVERT(DATETIME2(7),
            NULLIF(LTRIM(RTRIM(order_approved_at)), '')
        ) AS Approved_Date,

        TRY_CONVERT(DATETIME2(7),
            NULLIF(LTRIM(RTRIM(order_delivered_carrier_date)), '')
        ) AS Carrier_Date,

        TRY_CONVERT(DATETIME2(7),
            NULLIF(LTRIM(RTRIM(order_delivered_customer_date)), '')
        ) AS Customer_Date,

        TRY_CONVERT(DATETIME2(7),
            NULLIF(LTRIM(RTRIM(order_estimated_delivery_date)), '')
        ) AS Estimated_Date

    FROM Olist_DWH.bronze.Olist_Order_Dataset
)
SELECT *,
    CASE WHEN
        Purchase_Date IS NULL

        OR (
            NULLIF(LTRIM(RTRIM(Raw_Approved_Date)), '') IS NOT NULL
            AND Approved_Date IS NULL
        )

        OR (
            NULLIF(LTRIM(RTRIM(Raw_Carrier_Date)), '') IS NOT NULL
            AND Carrier_Date IS NULL
        )

        OR (
            NULLIF(LTRIM(RTRIM(Raw_Customer_Date)), '') IS NOT NULL
            AND Customer_Date IS NULL
        )

        OR (
            NULLIF(LTRIM(RTRIM(Raw_Estimated_Date)), '') IS NOT NULL
            AND Estimated_Date IS NULL
        )

    THEN 1 ELSE 0 END AS Invalid_Date_Flag
FROM CleanDates;</property>
