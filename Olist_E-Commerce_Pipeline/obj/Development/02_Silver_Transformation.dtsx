                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    order_id,
    order_item_id,
    product_id,
    seller_id,
    shipping_limit_date,
    price,
    freight_value,

    TRY_CONVERT(INT, order_item_id)
        AS Item_ID_Int,

    TRY_CONVERT(DATETIME2, shipping_limit_date)
        AS Shipping_Date_Converted,

    TRY_CONVERT(DECIMAL(10,2), price)
        AS Price_Decimal,

    TRY_CONVERT(DECIMAL(10,2), freight_value)
        AS Freight_Decimal

FROM Olist_DWH.bronze.Olist_Order_Items_Dataset;</property>
